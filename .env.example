# Every value here is fake and public by design. This demo instance is open to
# anyone; the credentials below identify nothing real.
#
# Generate the two secrets before the first run:
#
#   openssl rand -base64 32   # DSUI_MASTER_KEY   (must decode to exactly 32 bytes)
#   openssl rand -hex 24      # DEMO_ADMIN_SECRET

# Pin the image and the adapter `ref` in dsui.yaml to the same tag, so the demo
# always shows one coherent release rather than a moving mix.
DSUI_IMAGE_TAG=v0.1.1

# Encrypts stored connection credentials. Rotating it invalidates them.
DSUI_MASTER_KEY=

# Second-tier access for the maintainers. Presented by the demo-auth plugin;
# it grants role `owner` instead of the anonymous `operator`.
DEMO_ADMIN_SECRET=

# Port the demo is published on locally. In production this is fronted by a
# reverse proxy on a dedicated subdomain; only DSUI is ever exposed.
DSUI_PORT=4192

# Backing services. No published ports: reachable only on the compose network.
# DSUI connects as `dsui`, not as the `postgres` superuser.
POSTGRES_USER=dsui
POSTGRES_PASSWORD=dsui-demo-postgres
POSTGRES_DB=analytics

MINIO_ROOT_USER=dsui-demo
MINIO_ROOT_PASSWORD=dsui-demo-minio-secret

# Airflow. Its metadata lives in a separate `airflow` database on the same
# server, created by postgres-init, so a migration cannot touch demo data.
#   AIRFLOW_FERNET_KEY -> openssl rand -hex 32
AIRFLOW_FERNET_KEY=
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=dsui-demo-airflow

# Credentials adapter-airflow presents to the Airflow stable REST API. The
# password is base64 encoded because Airflow's simple auth manager expects
# `username:base64(password)`:
#   printf 'dsui-demo' | base64
AIRFLOW_API_USER=dsui-demo
AIRFLOW_API_PASSWORD_B64=
# The same password, unencoded, for the adapter to present over Basic auth.
AIRFLOW_API_PASSWORD=
