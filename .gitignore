.env

# Symlinks into a sibling checkout, used to run the plugin's tests and typecheck
# without a package manager. Never committed.
node_modules/

# Backing stores are containers and volumes, never files in the repository.
*.duckdb
*.duckdb.wal
/data/

# Python data generator
__pycache__/
*.py[cod]
.venv/
venv/

# dbt
# .user.yml holds an anonymous dbt user id written on first invocation. It is per
# machine and means nothing to anyone else.
/dbt/.user.yml
/dbt/target/
/dbt/dbt_packages/
/dbt/logs/

# Airflow
/airflow/logs/

.DS_Store

# Local CI fixtures
/.ci/

# Apple Containers local state
/.state/
